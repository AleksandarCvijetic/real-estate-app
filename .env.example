# Kopirati u .env (cp .env.example .env) i popuniti vrednosti.
# .env se ne commit-uje; docker compose ga automatski cita iz korena projekta.

# Lozinka korisnika "postgres". Primenjuje se samo pri prvom kreiranju volumena baze.
POSTGRES_PASSWORD=change-me

# HMAC kljuc za JWT (Base64, najmanje 256 bita). Isti kljuc koriste gateway i svi servisi.
# Generisanje: openssl rand -base64 64
JWT_SECRET=

# SMTP kredencijali za Mailtrap sandbox (Mailtrap -> Sandboxes -> Integration -> SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
