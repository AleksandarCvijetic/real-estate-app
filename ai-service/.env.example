# Za lokalno pokretanje ai-service-a van Docker-a: kopirati u ai-service/.env.
# U Docker-u se ove vrednosti zadaju u docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5433/ai_service_db
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=listing-events
KAFKA_GROUP_ID=ai-service

SERVICE_PORT=8085
EUREKA_SERVER=http://localhost:8761/eureka
